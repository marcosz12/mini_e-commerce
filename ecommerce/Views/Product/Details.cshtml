@using ecommerce.Models;
@model Product;

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="Imagem do @Model.Name" class="img-fluid" />
    </div>
    <div class="col-md-6">
        <h3>@Model.Name</h3>
        <p><strong>Preço:</strong> @Model.Price.ToString("C")</p>
        <p><strong>Descrição:</strong> @Model.Description</p>
        <p><strong>Estoque:</strong> @Model.Stock</p>

        <div class="form-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Voltar para a lista</a>
        </div>
    </div>
</div>
